<%- include("partials/header", { title: "Member Search", authenticated: true }) %>
<div class="breadcrumbs"><a href="/dashboard" data-control-owner="AUTOMATION" data-action-risk="SAFE">Home</a> &gt; Member Search</div>
<section class="panel" data-page-state="member-search">
  <h1>Member Search</h1>
  <p>Search by the complete member ID.</p>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form action="/members/search" method="post" class="inline-form">
    <div>
      <label for="memberId">Member ID</label>
      <input id="memberId" name="memberId" value="<%= query %>" placeholder="M-00000" required data-control-owner="AUTOMATION" data-action-risk="SENSITIVE" data-sensitive="true" />
    </div>
    <button type="submit" data-control-owner="AUTOMATION" data-action-risk="SAFE">Search</button>
  </form>
</section>
<%- include("partials/footer") %>
