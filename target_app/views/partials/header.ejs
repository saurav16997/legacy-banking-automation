<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> | Heritage Community Credit Union</title>
    <link rel="stylesheet" href="/static/styles.css" />
  </head>
  <body>
    <header class="masthead">
      <div>
        <p class="system-name">Heritage Community Credit Union</p>
        <p class="system-subtitle">Employee Account Services</p>
      </div>
      <% if (authenticated) { %>
        <form action="/logout" method="post">
          <button class="link-button" type="submit" data-control-owner="AUTOMATION" data-action-risk="SAFE">Sign out</button>
        </form>
      <% } %>
    </header>
    <nav class="utility-nav" aria-label="Primary navigation">
      <a href="/dashboard" data-control-owner="AUTOMATION" data-action-risk="SAFE">Home</a>
      <a href="/members/search" data-control-owner="AUTOMATION" data-action-risk="SAFE">Member Search</a>
    </nav>
    <main class="page-shell">
