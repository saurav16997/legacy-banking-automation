{
  "name": "interface-cua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic computer-use automation with bounded probabilistic discovery.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run tests",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "target:start": "tsx target_app/server.ts",
    "discover": "tsx src/cli/index.ts",
    "discover:prepare": "tsx src/cli/index.ts --task=prepare_savings_subaccount",
    "discover:prepare:headed": "tsx src/cli/index.ts --task=prepare_savings_subaccount --headed",
    "compile:prepare": "npm run build --silent && node dist/src/cli/compile-prepare.js",
    "replay:prepare": "npm run build --silent && node dist/src/cli/replay-prepare.js",
    "replay:prepare:demo": "npm run build --silent && node dist/src/cli/replay-prepare.js --allow-draft",
    "replay:prepare:demo:headed": "npm run build --silent && node dist/src/cli/replay-prepare.js --allow-draft --headed",
    "replay:prepare:handoff": "npm run build --silent && node dist/src/cli/replay-prepare-handoff.js --allow-draft"
  },
  "dependencies": {
    "@openai/agents": "^0.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.1",
    "ejs": "^6.0.1",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^5.0.1"
  }
}
